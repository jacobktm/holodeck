[Unit]
Description=Immutable boot counter — auto-rollback on repeated boot failures
DefaultDependencies=no
After=local-fs.target immutable-data-mount.service
Before=multi-user.target immutable-healthcheck.service
RequiresMountsFor=/pool

[Service]
Type=oneshot
ExecStart=/usr/lib/immutable/immutable-boot-counter.sh
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
