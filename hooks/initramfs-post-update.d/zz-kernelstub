#!/bin/bash
# Immutable-aware kernelstub replacement for initramfs post-update.
# Runs kernelstub when /boot/efi is a real block device AND / is a mountpoint
# (booted overlay), otherwise copies files directly (chroot contexts).

sync_back_to_overlay() {
    local subvol
    subvol=$(findmnt -no OPTIONS / 2>/dev/null | grep -oP 'subvol=\K[^,]+' 2>/dev/null)
    [ -n "$subvol" ] || return 0
    case "$subvol" in
        @overlay-*) ;;
        *) return 0 ;;
    esac
    local overlay_esp="/pool/$subvol/boot/efi"
    [ -d "$overlay_esp" ] || return 0
    rsync -a /boot/efi/ "$overlay_esp/" 2>/dev/null || true
}

read_kernelstub_opts() {
    local config_file="/etc/kernelstub/configuration"
    if [ -f "$config_file" ]; then
        python3 -c "
import json, sys
try:
    with open('$config_file') as f:
        cfg = json.load(f)
    opts = cfg.get('user', cfg.get('default', {})).get('kernel_options', [])
    print(' '.join(opts))
except Exception:
    sys.exit(1)
" 2>/dev/null && return 0
    fi
    echo "quiet splash"
}

sync_immutable_conf_opts() {
    local conf_path="$1"
    local ks_opts="$2"
    [ -f "$conf_path" ] || return 0

    local line
    line=$(grep '^options ' "$conf_path" 2>/dev/null || true)
    [ -n "$line" ] || return 0

    local root_uuid="" ro_flag="" rootflags=""
    local current_opts=""
    local rest="${line#options }"
    local parts=()
    read -ra parts <<< "$rest"

    for part in "${parts[@]}"; do
        case "$part" in
            root=UUID=*)
                root_uuid="$part"
                ;;
            ro)
                ro_flag="ro"
                ;;
            rootflags=subvol=*)
                rootflags="$part"
                ;;
            *)
                current_opts="$current_opts $part"
                ;;
        esac
    done
    current_opts="${current_opts# }"

    local ks_parts=()
    read -ra ks_parts <<< "$ks_opts"
    for opt in "${ks_parts[@]}"; do
        local key="${opt%%=*}"
        local found=0
        for existing in "${parts[@]}"; do
            local existing_key="${existing%%=*}"
            if [ "$existing_key" = "$key" ]; then
                found=1
                break
            fi
        done
        if [ "$found" -eq 0 ]; then
            current_opts="$current_opts $opt"
        fi
    done
    current_opts="${current_opts# }"

    local new_opts="$root_uuid ro $current_opts $rootflags"
    new_opts=$(echo "$new_opts" | tr -s ' ' | sed 's/[[:space:]]*$//')
    new_opts="${new_opts# }"

    local linux_line initrd_line
    linux_line=$(grep '^linux ' "$conf_path" 2>/dev/null || true)
    initrd_line=$(grep '^initrd ' "$conf_path" 2>/dev/null || true)

    {
        echo "title Immutable"
        [ -n "$linux_line" ] && echo "$linux_line" || echo "linux /EFI/Pop_OS-$(ls /boot/efi/EFI/ 2>/dev/null | grep -oP 'Pop_OS-\K.*' || echo 'unknown')/vmlinuz.efi"
        [ -n "$initrd_line" ] && echo "$initrd_line" || echo "initrd /EFI/Pop_OS-$(ls /boot/efi/EFI/ 2>/dev/null | grep -oP 'Pop_OS-\K.*' || echo 'unknown')/initrd.img"
        echo "options $new_opts"
    } > "$conf_path" 2>/dev/null || true
}

find_esp_dir() {
    local esp_base="$1"
    for d in "$esp_base"/EFI/Pop_OS-*; do
        if [ -d "$d" ]; then
            echo "$d"
            return 0
        fi
    done
    if [ -d "$esp_base/EFI/systemd" ]; then
        echo "$esp_base/EFI/systemd"
        return 0
    fi
    return 1
}

# --- Environment detection ---
ESP_SRC=$(findmnt -no SOURCE /boot/efi 2>/dev/null || true)

if [ -n "$ESP_SRC" ] && [ -b "$ESP_SRC" ] && [ "$(findmnt -no FSTYPE / 2>/dev/null)" = "overlay" ]; then
    # Host path: booted overlay — run kernelstub
    ESP="/boot/efi"

    RO_WAS=""
    if findmnt -no OPTIONS "$ESP" 2>/dev/null | grep -qw ro; then
        RO_WAS=1
        mount -o remount,rw "$ESP" 2>/dev/null || exit 0
    fi

    KERNEL="/boot/vmlinuz-$1"
    INITRD="$2"

    kernelstub --verbose --preserve-live-mode || true

    KS_OPTS=$(read_kernelstub_opts)
    sync_immutable_conf_opts "${ESP}/loader/entries/immutable.conf" "$KS_OPTS"

    sync_back_to_overlay

    [ -n "$RO_WAS" ] && mount -o remount,ro "$ESP" 2>/dev/null || true
elif mountpoint -q /boot/efi 2>/dev/null; then
    # Chroot path: /boot/efi is mounted (install.sh block device or overlay shell bind)
    ESP="/boot/efi"
    ESP_DIR=$(find_esp_dir "$ESP")
    if [ -z "$ESP_DIR" ]; then
        # Self-heal: the ESP copy has no kernel directory. Create one so the
        # initramfs update still lands. UUID from an existing Pop_OS-* dir,
        # else the root=UUID= on the boot cmdline (the pool UUID).
        esp_uuid=""
        for d in "$ESP"/EFI/Pop_OS-*; do
            [ -d "$d" ] || continue
            esp_uuid="${d##*/Pop_OS-}"
            break
        done
        [ -n "$esp_uuid" ] || esp_uuid="$(grep -oP 'root=UUID=\K[0-9a-fA-F-]+' /proc/cmdline 2>/dev/null | head -n1 || true)"
        if [ -n "$esp_uuid" ]; then
            mkdir -p "$ESP/EFI/Pop_OS-$esp_uuid" 2>/dev/null && ESP_DIR="$ESP/EFI/Pop_OS-$esp_uuid"
        fi
    fi
    [ -n "$ESP_DIR" ] || exit 0

    INITRD_SRC="$2"
    [ -f "$INITRD_SRC" ] || exit 0

    if [ -f "${ESP_DIR}/initrd.img" ]; then
        rm -f "${ESP_DIR}/initrd.img-previous" 2>/dev/null || true
        cp "${ESP_DIR}/initrd.img" "${ESP_DIR}/initrd.img-previous" 2>/dev/null || true
    fi

    cp "$INITRD_SRC" "${ESP_DIR}/initrd.img" 2>/dev/null || true
    cp /proc/cmdline "${ESP_DIR}/cmdline" 2>/dev/null || true

    KS_OPTS=$(read_kernelstub_opts)
    sync_immutable_conf_opts "${ESP}/loader/entries/immutable.conf" "$KS_OPTS"

    exit 0
fi
