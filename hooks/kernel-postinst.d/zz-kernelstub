#!/bin/bash
# Immutable-aware kernelstub replacement for kernel post-install.
# Runs kernelstub when /boot/efi is a real block device AND / is a mountpoint
# (booted overlay), otherwise copies files directly (chroot contexts).

sync_back_to_overlay() {
    local subvol
    subvol=$(findmnt -no OPTIONS / 2>/dev/null | grep -oP 'subvol=\K[^,]+' 2>/dev/null)
    [ -n "$subvol" ] || return 0
    case "$subvol" in
        @overlay-*) ;;
        *) return 0 ;;
    esac
    local overlay_esp="/pool/$subvol/boot/efi"
    [ -d "$overlay_esp" ] || return 0
    rsync -a --delete /boot/efi/ "$overlay_esp/" 2>/dev/null || true
}

read_kernelstub_opts() {
    local config_file="/etc/kernelstub/configuration"
    if [ -f "$config_file" ]; then
        python3 -c "
import json, sys
try:
    with open('$config_file') as f:
        cfg = json.load(f)
    opts = cfg.get('user', cfg.get('default', {})).get('kernel_options', [])
    print(' '.join(opts))
except Exception:
    sys.exit(1)
" 2>/dev/null && return 0
    fi
    echo "quiet splash"
}

sync_immutable_conf_opts() {
    local conf_path="$1"
    local ks_opts="$2"
    [ -f "$conf_path" ] || return 0

    local line
    line=$(grep '^options ' "$conf_path" 2>/dev/null || true)
    [ -n "$line" ] || return 0

    local root_uuid="" ro_flag="" rootflags=""
    local current_opts=""
    local rest="${line#options }"
    local parts=()
    read -ra parts <<< "$rest"

    for part in "${parts[@]}"; do
        case "$part" in
            root=UUID=*)
                root_uuid="$part"
                ;;
            ro)
                ro_flag="ro"
                ;;
            rootflags=subvol=*)
                rootflags="$part"
                ;;
            *)
                current_opts="$current_opts $part"
                ;;
        esac
    done
    current_opts="${current_opts# }"

    local ks_parts=()
    read -ra ks_parts <<< "$ks_opts"
    for opt in "${ks_parts[@]}"; do
        local key="${opt%%=*}"
        local found=0
        for existing in "${parts[@]}"; do
            local existing_key="${existing%%=*}"
            if [ "$existing_key" = "$key" ]; then
                found=1
                break
            fi
        done
        if [ "$found" -eq 0 ]; then
            current_opts="$current_opts $opt"
        fi
    done
    current_opts="${current_opts# }"

    local new_opts="$root_uuid ro $current_opts $rootflags"
    new_opts=$(echo "$new_opts" | tr -s ' ' | sed 's/[[:space:]]*$//')
    new_opts="${new_opts# }"

    local linux_line initrd_line
    linux_line=$(grep '^linux ' "$conf_path" 2>/dev/null || true)
    initrd_line=$(grep '^initrd ' "$conf_path" 2>/dev/null || true)

    {
        echo "title Immutable"
        [ -n "$linux_line" ] && echo "$linux_line" || echo "linux /EFI/Pop_OS-$(ls /boot/efi/EFI/ 2>/dev/null | grep -oP 'Pop_OS-\K.*' || echo 'unknown')/vmlinuz.efi"
        [ -n "$initrd_line" ] && echo "$initrd_line" || echo "initrd /EFI/Pop_OS-$(ls /boot/efi/EFI/ 2>/dev/null | grep -oP 'Pop_OS-\K.*' || echo 'unknown')/initrd.img"
        echo "options $new_opts"
    } > "$conf_path" 2>/dev/null || true
}

find_esp_dir() {
    local esp_base="$1"
    for d in "$esp_base"/EFI/Pop_OS-*; do
        if [ -d "$d" ]; then
            echo "$d"
            return 0
        fi
    done
    if [ -d "$esp_base/EFI/systemd" ]; then
        echo "$esp_base/EFI/systemd"
        return 0
    fi
    return 1
}

luks_root_entry() {
    # Echo the first passphrase-required LUKS crypttab line (target then line).
    [ -f /etc/crypttab ] || return 1
    awk -F'[[:space:]]+' '
        /^[[:space:]]*#/ || NF < 4 { next }
        $3 == "none" && $4 ~ /(^|,)luks(,|$)/ { print $1, $0; exit }
    ' /etc/crypttab
}

initrd_has_cryptroot() {
    local initrd="$1" want="$2" tmp
    [ -f "$initrd" ] || return 1
    [ -n "$want" ] || return 1
    command -v unmkinitramfs >/dev/null 2>&1 || return 0
    tmp=$(mktemp -d)
    if unmkinitramfs -t "$tmp" "$initrd" >/dev/null 2>&1 && \
       [ -s "$tmp/cryptroot/crypttab" ] && grep -qw "$want" "$tmp/cryptroot/crypttab"; then
        rm -rf "$tmp"
        return 0
    fi
    rm -rf "$tmp"
    return 1
}

# --- LUKS root initrd integrity check ---
# The cryptroot hook's root-device detection (get_mnt_devno(/)) cannot resolve
# the btrfs root from inside an overlay-shell chroot, so a passphrase LUKS
# entry lacking the `initramfs` crypttab option is silently dropped from the
# initrd, and the system boots to a busybox shell before the decrypt prompt.
# Verify the initrd about to be copied to the ESP carries that entry's
# cryptroot config and fail loudly instead of copying a broken one.
LUKS_ENTRY=$(luks_root_entry)
INITRD_CHECK="/boot/initrd.img-$1"
if [ -n "$LUKS_ENTRY" ] && [ -n "$INITRD_CHECK" ] && [ -f "$INITRD_CHECK" ]; then
    LUKS_TARGET=${LUKS_ENTRY%% *}
    if ! initrd_has_cryptroot "$INITRD_CHECK" "$LUKS_TARGET"; then
        echo "zz-kernelstub: ERROR: initrd '$INITRD_CHECK' has no cryptroot config for '$LUKS_TARGET', but /etc/crypttab requires a boot-time passphrase. The cryptroot hook cannot resolve the root device inside this chroot; add the 'initramfs' option to that crypttab entry and re-run update-initramfs." >&2
        exit 1
    fi
fi

# --- Environment detection ---
ESP_SRC=$(findmnt -no SOURCE /boot/efi 2>/dev/null || true)

if [ -n "$ESP_SRC" ] && [ -b "$ESP_SRC" ] && [ "$(findmnt -no FSTYPE / 2>/dev/null)" = "overlay" ]; then
    # Host path: booted overlay — run kernelstub
    ESP="/boot/efi"

    RO_WAS=""
    if findmnt -no OPTIONS "$ESP" 2>/dev/null | grep -qw ro; then
        RO_WAS=1
        mount -o remount,rw "$ESP" 2>/dev/null || exit 0
    fi

    INITRD="/boot/initrd.img-$1"
    KERNEL="$2"

    kernelstub --verbose --preserve-live-mode || true

    KS_OPTS=$(read_kernelstub_opts)
    sync_immutable_conf_opts "${ESP}/loader/entries/immutable.conf" "$KS_OPTS"

    sync_back_to_overlay

    [ -n "$RO_WAS" ] && mount -o remount,ro "$ESP" 2>/dev/null || true
elif [ -d /boot/efi ]; then
    # Direct-copy path: the real ESP on the booted host, or an overlay ESP clone
    # bind-mounted into a shell chroot. (mountpoint -q cannot see the clone from
    # inside the chroot: /proc/self/mountinfo paths are host-rooted while the
    # process's /boot/efi is chroot-rooted, so the path never matches.)
    ESP="/boot/efi"

    RO_WAS=""
    if findmnt -no OPTIONS "$ESP" 2>/dev/null | grep -qw ro; then
        RO_WAS=1
        mount -o remount,rw "$ESP" 2>/dev/null || exit 0
    fi

    ESP_DIR=$(find_esp_dir "$ESP")
    if [ -z "$ESP_DIR" ]; then
        # Self-heal: the ESP copy has no kernel directory. Create one so the
        # kernel update still lands. UUID from an existing Pop_OS-* dir, else
        # the root=UUID= on the boot cmdline (the pool UUID).
        esp_uuid=""
        for d in "$ESP"/EFI/Pop_OS-*; do
            [ -d "$d" ] || continue
            esp_uuid="${d##*/Pop_OS-}"
            break
        done
        [ -n "$esp_uuid" ] || esp_uuid="$(grep -oP 'root=UUID=\K[0-9a-fA-F-]+' /proc/cmdline 2>/dev/null | head -n1 || true)"
        if [ -n "$esp_uuid" ]; then
            mkdir -p "$ESP/EFI/Pop_OS-$esp_uuid" 2>/dev/null && ESP_DIR="$ESP/EFI/Pop_OS-$esp_uuid"
        fi
    fi
    [ -n "$ESP_DIR" ] || exit 0

    KERNEL_SRC="$2"
    INITRD_SRC="/boot/initrd.img-$1"
    [ -f "$KERNEL_SRC" ] || exit 0
    [ -f "$INITRD_SRC" ] || exit 0

    if [ -f "${ESP_DIR}/vmlinuz.efi" ]; then
        rm -f "${ESP_DIR}/vmlinuz-previous.efi" 2>/dev/null || true
        cp "${ESP_DIR}/vmlinuz.efi" "${ESP_DIR}/vmlinuz-previous.efi" 2>/dev/null || true
    fi
    if [ -f "${ESP_DIR}/initrd.img" ]; then
        rm -f "${ESP_DIR}/initrd.img-previous" 2>/dev/null || true
        cp "${ESP_DIR}/initrd.img" "${ESP_DIR}/initrd.img-previous" 2>/dev/null || true
    fi

    if [ "$(xxd -l 2 -p "$KERNEL_SRC" 2>/dev/null)" = "1f8b" ]; then
        gunzip -c "$KERNEL_SRC" > "${ESP_DIR}/vmlinuz.efi" 2>/dev/null || \
        cp "$KERNEL_SRC" "${ESP_DIR}/vmlinuz.efi" 2>/dev/null || true
    else
        cp "$KERNEL_SRC" "${ESP_DIR}/vmlinuz.efi" 2>/dev/null || true
    fi

    cp "$INITRD_SRC" "${ESP_DIR}/initrd.img" 2>/dev/null || true
    cp /proc/cmdline "${ESP_DIR}/cmdline" 2>/dev/null || true

    KS_OPTS=$(read_kernelstub_opts)
    sync_immutable_conf_opts "${ESP}/loader/entries/immutable.conf" "$KS_OPTS"

    [ -n "$RO_WAS" ] && mount -o remount,ro "$ESP" 2>/dev/null || true

    exit 0
fi
