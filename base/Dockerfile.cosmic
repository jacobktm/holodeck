# Nested COSMIC session base image.
# Extends pop-os:24.04-latest with a full COSMIC desktop stack
# for testing packages that need their own session (e.g. cosmic-settings).
FROM pop-os:24.04-latest

# Install COSMIC desktop components for nested session testing.
# cosmic-session starts the desktop, cosmic-comp is the compositor,
# cosmic-panel is the panel, cosmic-settings-daemon handles settings.
# cosmic-settings is NOT installed here — it comes from the PR branch.
RUN apt-get update
RUN apt-get install -y --allow-downgrades \
    cosmic-session \
    cosmic-comp \
    cosmic-panel \
    cosmic-settings-daemon \
    cosmic-osd \
    cosmic-notifications \
    cosmic-applets \
    dbus-x11
RUN apt-get full-upgrade -y --allow-downgrades
RUN rm -rf /var/lib/apt/lists/*
