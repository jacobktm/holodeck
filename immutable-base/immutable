#!/bin/bash
set -euo pipefail

# ── Immutable Pop!_OS: Overlay Management CLI ──

# Re-exec as root if not already
if [ "$(id -u)" -ne 0 ]; then
    exec sudo "$0" "$@"
fi

VERSION="0.3.0"
POOL="${IMMUTABLE_POOL:-/pool}"
BASE_SUBVOL="@base"
DATA_SUBVOL="@data"
SNAPSHOTS_SUBVOL="@snapshots"
OVERLAY_PREFIX="@overlay-"
RECOVERY_OVERLAY="recovery"
BOOT_COUNTER="$POOL/$DATA_SUBVOL/boot-counter"
BOOT_OK_MARKER="$POOL/$DATA_SUBVOL/boot-ok"
BOOT_THRESHOLD=3

# If @data has its own copy of this script, run that instead.
# This lets users update the CLI once in @data and have all overlays see it.
_DATA_SCRIPT="$POOL/$DATA_SUBVOL/immutable"
if [ "$0" != "$_DATA_SCRIPT" ] && [ -f "$_DATA_SCRIPT" ] && [ -x "$_DATA_SCRIPT" ]; then
    exec "$_DATA_SCRIPT" "$@"
fi

# ── Helpers ──

IMMUTABLE_CONF="/etc/immutable.conf"

get_username() {
    if [ -f "$IMMUTABLE_CONF" ]; then
        local user
        user=$(grep '^USERNAME=' "$IMMUTABLE_CONF" | cut -d= -f2)
        [ -n "$user" ] && echo "$user" && return
    fi
    # Fallback: find first non-root user in /home
    local user
    for d in /home/*; do
        [ -d "$d" ] || continue
        user=$(basename "$d")
        [ "$user" = "root" ] && continue
        echo "$user"
        return
    done
    echo "USERNAME"  # last resort
}

usage() {
    cat <<EOF
immutable v${VERSION} — Overlay management for immutable Pop!_OS

Usage:
  immutable create <name>       Create a new overlay (snapshot of @base)
  immutable shell <name>        Chroot into an overlay
  immutable run <name> <cmd>    Run a command in an overlay
  immutable list                Show all overlays
  immutable switch <name>       Set default boot overlay (needs reboot)
  immutable reset <name>        Wipe overlay, re-snapshot from @base
  immutable delete <name>       Remove an overlay
  immutable status              Show current overlay and boot config
  immutable lock                Make @base read-only (disable apt)
  immutable unlock              Make @base writable (enable apt)
  immutable recovery            Switch to recovery overlay and reboot
  immutable reset-recovery      Recreate recovery overlay from @base
  immutable healthcheck         Check boot health (called by systemd)
  immutable boot-ok             Mark current boot as healthy
  immutable update              Update CLI in @data (all overlays see it)
EOF
}

die() { echo "ERROR: $*" >&2; exit 1; }

require_root() {
    [ "$(id -u)" -eq 0 ] || die "Must run as root"
}

pool_mounted() {
    mountpoint -q "$POOL" 2>/dev/null
}

ensure_pool() {
    require_root
    if ! pool_mounted; then
        # Find the BTRFS partition
        local dev=$(findmnt -n -o SOURCE / 2>/dev/null || true)
        if [ -z "$dev" ]; then
            die "Cannot determine root device. Is the system installed?"
        fi
        local fs_type=$(findmnt -n -o FSTYPE / 2>/dev/null || true)
        if [ "$fs_type" != "btrfs" ]; then
            die "Root filesystem is not BTRFS (found $fs_type)"
        fi
        mkdir -p "$POOL"
        mount -o subvolid=5 "$dev" "$POOL"
    fi
}

check_pool() {
    # Like ensure_pool but doesn't require root — just verifies pool is accessible
    if ! pool_mounted; then
        die "Pool not mounted at $POOL. Run as root or check fstab."
    fi
}

base_path() { echo "$POOL/$BASE_SUBVOL"; }
overlay_path() {
    local name="$1"
    case "$name" in
        @base)   echo "$POOL/$BASE_SUBVOL" ;;
        @data)   echo "$POOL/$DATA_SUBVOL" ;;
        *)       echo "$POOL/$OVERLAY_PREFIX$name" ;;
    esac
}
data_path() { echo "$POOL/$DATA_SUBVOL"; }
snapshots_path() { echo "$POOL/$SNAPSHOTS_SUBVOL"; }

# ── Commands ──

cmd_create() {
    local name="${1:?Usage: immutable create <name>}"
    ensure_pool

    local dst=$(overlay_path "$name")
    [ -d "$dst" ] && die "Overlay '$name' already exists"

    local src=$(base_path)
    [ -d "$src" ] || die "Base system not found at $src"

    echo "Creating overlay '$name' from @base..."
    btrfs subvolume snapshot "$src" "$dst"
    echo "Created: $dst"
    echo ""
    echo "Next steps:"
    echo "  immutable shell $name      # enter overlay"
    echo "  immutable switch $name     # set as boot default (needs reboot)"
}

cmd_shell() {
    local name="${1:?Usage: immutable shell <name> [command...]}"
    shift
    ensure_pool

    local dst=$(overlay_path "$name")
    [ -d "$dst" ] || die "Overlay '$name' not found. Use 'immutable list' to see available overlays."

    echo "Entering overlay '$name'..."
    if [ $# -gt 0 ]; then
        _chroot_overlay "$dst" "$@"
    else
        _chroot_overlay "$dst" /bin/bash
    fi
}

cmd_run() {
    local name="${1:?Usage: immutable run <name> <cmd>}"
    shift
    [ $# -eq 0 ] && die "No command specified"
    ensure_pool

    local dst=$(overlay_path "$name")
    [ -d "$dst" ] || die "Overlay '$name' not found"

    _chroot_overlay "$dst" "$@"
}

cmd_list() {
    check_pool

    echo "Overlays:"
    echo ""

    # Show base
    local base=$(base_path)
    if [ -d "$base" ]; then
        local ro=$(btrfs property get "$base" ro 2>/dev/null | grep -oP '(?<=ro=)\S+')
        echo "  @base (read-only: $ro) — $base"
    fi

    # Show overlays (use btrfs subvolume list to avoid glob issues with @ in names)
    local count=0
    local list_output
    list_output=$(btrfs subvolume list "$POOL" 2>/dev/null || true)
    local path name full size
    while IFS= read -r line; do
        path=$(echo "$line" | grep -oP 'path \K.*')
        case "$path" in
            @overlay-*)
                name="${path#@overlay-}"
                full="$POOL/$path"
                size=$(du -sh "$full" 2>/dev/null | cut -f1)
                echo "  $name ($size) — $full"
                count=$((count + 1))
                ;;
        esac
    done <<< "$list_output"
    [ "$count" -eq 0 ] && echo "  (none)"

    # Show data
    local data=$(data_path)
    if [ -d "$data" ]; then
        echo ""
        echo "  @data — $data"
    fi

    # Show current boot overlay
    echo ""
    _show_boot_config
}

cmd_switch() {
    local name="${1:?Usage: immutable switch <name>}"
    require_root
    _switch_to "$name"
    echo "Reboot to activate."
}

cmd_reset() {
    local name="${1:?Usage: immutable reset <name>}"
    ensure_pool

    local dst=$(overlay_path "$name")
    [ -d "$dst" ] || die "Overlay '$name' not found"

    local src=$(base_path)

    echo "Resetting overlay '$name' from @base..."
    btrfs subvolume delete "$dst"
    btrfs subvolume snapshot "$src" "$dst"
    echo "Reset complete: $dst"
}

cmd_delete() {
    local name="${1:?Usage: immutable delete <name>}"
    ensure_pool

    local dst=$(overlay_path "$name")
    [ -d "$dst" ] || die "Overlay '$name' not found"

    # Don't delete the active boot overlay
    local current=$(cat /boot/efi/loader/entries/immutable.conf 2>/dev/null | grep -o 'subvol=[^ ]*' | head -1 | cut -d= -f2 || true)
    if [ "$current" = "@overlay-${name}" ]; then
        die "Cannot delete active boot overlay. Switch to another first."
    fi

    echo "Deleting overlay '$name'..."
    btrfs subvolume delete "$dst"
    echo "Deleted."
}

cmd_status() {
    check_pool
    echo "=== Immutable Status ==="
    echo ""
    _show_boot_config
    echo ""
    echo "=== Subvolumes ==="
    btrfs subvolume list "$POOL" 2>/dev/null || echo "(unable to list)"
}

cmd_lock() {
    ensure_pool
    local base=$(base_path)
    [ -d "$base" ] || die "Base system not found"

    echo "Making @base read-only..."
    btrfs property set "$base" ro true
    echo "@base is now read-only. Use 'immutable unlock' to make writable."
}

cmd_unlock() {
    ensure_pool
    local base=$(base_path)
    [ -d "$base" ] || die "Base system not found"

    echo "Making @base writable..."
    btrfs property set "$base" ro false
    echo "@base is now writable. Run apt update/upgrade as needed."
    echo "Use 'immutable lock' when done."
}

cmd_recovery() {
    require_root

    local recovery=$(overlay_path "$RECOVERY_OVERLAY")
    if [ ! -d "$recovery" ]; then
        echo "Recovery overlay not found. Creating from @base..."
        ensure_pool
        btrfs subvolume snapshot "$(base_path)" "$recovery"
    fi

    echo "Switching to recovery overlay..."
    _switch_to "$RECOVERY_OVERLAY"

    echo "Rebooting into recovery..."
    reboot
}

cmd_reset_recovery() {
    ensure_pool
    local recovery=$(overlay_path "$RECOVERY_OVERLAY")
    local src=$(base_path)

    if [ -d "$recovery" ]; then
        echo "Deleting old recovery overlay..."
        btrfs subvolume delete "$recovery"
    fi

    echo "Creating recovery overlay from @base..."
    btrfs subvolume snapshot "$src" "$recovery"
    echo "Recovery overlay created: $recovery"
}

cmd_healthcheck() {
    # Run as a systemd service. Exit 0 = healthy, exit 1 = unhealthy.
    # Check that essential services can be reached.
    local healthy=true

    # Check if / is writable (overlay is working)
    if ! touch /.healthcheck-test 2>/dev/null; then
        echo "FAIL: root filesystem not writable"
        healthy=false
    fi
    rm -f /.healthcheck-test 2>/dev/null

    # Check that systemd is functioning
    if ! systemctl is-system-running --quiet 2>/dev/null; then
        local state=$(systemctl is-system-running 2>/dev/null || echo "unknown")
        if [ "$state" = "degraded" ]; then
            echo "WARN: systemd in degraded state (non-fatal)"
        elif [ "$state" = "maintenance" ]; then
            echo "FAIL: systemd in maintenance mode"
            healthy=false
        fi
    fi

    if $healthy; then
        echo "Boot healthcheck: PASS"
        exit 0
    else
        echo "Boot healthcheck: FAIL"
        exit 1
    fi
}

cmd_boot_ok() {
    # Mark current boot as healthy — reset boot counter
    check_pool
    local data=$(data_path)
    mkdir -p "$data" 2>/dev/null || true

    echo "1" > "$BOOT_OK_MARKER" 2>/dev/null || true
    echo "0" > "$BOOT_COUNTER" 2>/dev/null || true
    echo "Boot marked as healthy."
}

cmd_update() {
    # Copy this script to @data so all overlays use the updated version
    require_root
    check_pool

    local data=$(data_path)
    mkdir -p "$data" 2>/dev/null || true

    local dest="$data/immutable"
    local src="$0"

    # If running from @data (the exec redirect), use the shim at /usr/local/bin
    if [ "$src" = "$dest" ]; then
        src="/usr/local/bin/immutable"
    fi

    cp "$src" "$dest"
    chmod +x "$dest"
    echo "CLI updated in @data. All overlays will use this version."
}

# ── Internal functions ──

_switch_to() {
    local name="${1:?Usage: immutable switch <name>}"
    ensure_pool

    local dst=$(overlay_path "$name")
    [ -d "$dst" ] || die "Overlay '$name' not found"

    local entry="/boot/efi/loader/entries/immutable.conf"
    if [ -f "$entry" ]; then
        sed -i "s|rootflags=subvol=[^ ]*|rootflags=subvol=@overlay-${name}|g" "$entry"
        echo "Boot entry updated to: @overlay-${name}"
    else
        echo "Boot entry not found at $entry"
        echo "Manually set rootflags=subvol=@overlay-${name} in your boot config."
    fi
}

_chroot_overlay() {
    local root="$1"
    shift

    local username
    username=$(get_username)

    # Mount API filesystems
    mkdir -p "$root"/{dev,dev/pts,proc,sys,run,tmp}
    mount --bind /dev "$root/dev" 2>/dev/null || true
    # Mount devpts separately — bind mount after /dev can fail
    mount -t devpts devpts "$root/dev/pts" -o "gid=5,mode=620,ptmxmode=000" 2>/dev/null || \
        mount --bind /dev/pts "$root/dev/pts" 2>/dev/null || true
    mount -t proc proc "$root/proc" 2>/dev/null || true
    mount --rbind /sys "$root/sys" 2>/dev/null || true
    mount --make-rslave "$root/sys" 2>/dev/null || true
    mount --bind /run "$root/run" 2>/dev/null || true
    mount --bind /tmp "$root/tmp" 2>/dev/null || true

    # Mount data partition into home
    local data=$(data_path)
    if [ -d "$data" ]; then
        local home_dir="$root/home/$username"
        mkdir -p "$home_dir"
        for dir in Documents Downloads Pictures Videos Music; do
            mkdir -p "$home_dir/$dir"
            mount --bind "$data/$dir" "$home_dir/$dir" 2>/dev/null || true
        done
        # Persist dotfiles that should survive overlay reverts
        for dotfile in .bash_history .profile .bashrc .gitconfig; do
            [ -f "$data/$dotfile" ] || touch "$data/$dotfile"
            mount --bind "$data/$dotfile" "$home_dir/$dotfile" 2>/dev/null || true
        done
    fi

    # DNS resolution
    cp /etc/resolv.conf "$root/etc/resolv.conf" 2>/dev/null || true

    # Enter chroot as the user
    local rc=0
    if [ $# -gt 0 ]; then
        chroot "$root" su - "$username" -c "$*" || rc=$?
    else
        chroot "$root" su - "$username" || rc=$?
    fi

    # Cleanup mounts
    umount -R "$root/dev" 2>/dev/null || true
    umount -R "$root/proc" 2>/dev/null || true
    umount -R "$root/sys" 2>/dev/null || true
    umount "$root/run" 2>/dev/null || true
    umount "$root/tmp" 2>/dev/null || true
    for dir in Documents Downloads Pictures Videos Music; do
        umount "$root/home/$username/$dir" 2>/dev/null || true
    done
    for dotfile in .bash_history .profile .bashrc .gitconfig; do
        umount "$root/home/$username/$dotfile" 2>/dev/null || true
    done
    return $rc
}

_show_boot_config() {
    local entry="/boot/efi/loader/entries/immutable.conf"
    if [ -f "$entry" ]; then
        local subvol=$(grep -o 'subvol=[^ ]*' "$entry" | head -1 | cut -d= -f2 || true)
        echo "Boot overlay: ${subvol:-unknown}"
    else
        echo "Boot config: not found (system not installed?)"
    fi
}

# ── Main ──

case "${1:-}" in
    create)          shift; cmd_create "$@" ;;
    shell)           shift; cmd_shell "$@" ;;
    run)             shift; cmd_run "$@" ;;
    list)            shift; cmd_list "$@" ;;
    switch)          shift; cmd_switch "$@" ;;
    reset)           shift; cmd_reset "$@" ;;
    delete)          shift; cmd_delete "$@" ;;
    status)          shift; cmd_status "$@" ;;
    lock)            shift; cmd_lock "$@" ;;
    unlock)          shift; cmd_unlock "$@" ;;
    recovery)        shift; cmd_recovery "$@" ;;
    reset-recovery)  shift; cmd_reset_recovery "$@" ;;
    healthcheck)     shift; cmd_healthcheck "$@" ;;
    boot-ok)         shift; cmd_boot_ok "$@" ;;
    -h|--help|help|"") usage ;;
    *) die "Unknown command: $1 (try 'immutable help')" ;;
esac
