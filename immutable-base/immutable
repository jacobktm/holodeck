#!/usr/bin/env python3
"""Immutable Pop!_OS overlay management CLI.

Connects to the immutable-daemon over a Unix socket.
Runs as any user in the 'immutable' group.
"""
import sys
import os
import json
import socket
import struct
import signal
import select
import tty
import termios

VERSION = "0.4.0"
SOCKET_PATH = "/run/immutable/daemon.sock"


def connect() -> socket.socket:
    """Connect to the daemon socket."""
    if not os.path.exists(SOCKET_PATH):
        print("ERROR: Daemon not running. Start with: systemctl start immutable-daemon.socket",
              file=sys.stderr)
        sys.exit(1)

    sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    try:
        sock.connect(SOCKET_PATH)
    except ConnectionRefusedError:
        print("ERROR: Cannot connect to daemon. Is it running?", file=sys.stderr)
        print("  systemctl start immutable-daemon.socket", file=sys.stderr)
        sys.exit(1)
    return sock


def get_password():
    """Prompt for password (no echo)."""
    import getpass
    return getpass.getpass("Password: ")


def send_command(cmd: dict) -> dict:
    """Send a command to the daemon and return the response."""
    sock = connect()
    try:
        msg = json.dumps(cmd, separators=(",", ":")) + "\n"
        sock.sendall(msg.encode("utf-8"))

        buf = b""
        while True:
            chunk = sock.recv(1)
            if not chunk or chunk == b"\n":
                break
            buf += chunk

        if buf:
            return json.loads(buf.decode("utf-8"))
        return {"ok": False, "error": "No response from daemon"}
    finally:
        sock.close()


def cmd_simple(args: dict):
    """Send a simple command and print the output."""
    result = send_command(args)
    if result.get("auth_required"):
        args["password"] = get_password()
        result = send_command(args)
    if result.get("ok"):
        print(result.get("output", ""))
    else:
        print(f"ERROR: {result.get('error', 'Unknown error')}", file=sys.stderr)
        sys.exit(1)


def cmd_run(overlay: str, run_args: list):
    """Run a non-interactive command with streaming output."""
    sock = connect()
    try:
        cmd = {
            "cmd": "run",
            "overlay": overlay,
            "args": run_args,
            "env": {"TERM": os.environ.get("TERM", "xterm-256color")},
        }
        msg = json.dumps(cmd, separators=(",", ":")) + "\n"
        sock.sendall(msg.encode("utf-8"))

        exit_code = 1
        buf = b""
        auth_checked = False
        while True:
            chunk = sock.recv(4096)
            if not chunk:
                break

            buf += chunk
            while b"\n" in buf:
                line, buf = buf.split(b"\n", 1)
                if not line:
                    continue
                try:
                    event = json.loads(line.decode("utf-8"))
                except json.JSONDecodeError:
                    continue

                # Check for auth required on first response
                if not auth_checked and event.get("auth_required"):
                    sock.close()
                    cmd["password"] = get_password()
                    sock = connect()
                    msg = json.dumps(cmd, separators=(",", ":")) + "\n"
                    sock.sendall(msg.encode("utf-8"))
                    auth_checked = True
                    continue
                auth_checked = True

                if "error" in event and not event.get("ok", True):
                    print(f"ERROR: {event['error']}", file=sys.stderr)
                    sys.exit(1)
                elif event.get("stream") == "stdout":
                    sys.stdout.write(event.get("data", ""))
                    sys.stdout.flush()
                elif event.get("stream") == "stderr":
                    sys.stderr.write(event.get("data", ""))
                    sys.stderr.flush()
                elif event.get("type") == "done":
                    exit_code = event.get("exit_code", 1)

        sys.exit(exit_code)
    finally:
        sock.close()


def cmd_shell(overlay: str, shell_args: list):
    """Open an interactive shell session."""
    sock = connect()
    try:
        # Send PTY request
        cmd = {
            "cmd": "pty",
            "overlay": overlay,
            "args": shell_args,
        }
        msg = json.dumps(cmd, separators=(",", ":")) + "\n"
        sock.sendall(msg.encode("utf-8"))

        # Read initial response
        buf = b""
        while True:
            chunk = sock.recv(1)
            if not chunk or chunk == b"\n":
                break
            buf += chunk

        if not buf:
            print("ERROR: No response from daemon", file=sys.stderr)
            sys.exit(1)

        response = json.loads(buf.decode("utf-8"))

        # Handle auth required
        if response.get("auth_required"):
            sock.close()
            cmd["password"] = get_password()
            sock = connect()
            msg = json.dumps(cmd, separators=(",", ":")) + "\n"
            sock.sendall(msg.encode("utf-8"))
            buf = b""
            while True:
                chunk = sock.recv(1)
                if not chunk or chunk == b"\n":
                    break
                buf += chunk
            if not buf:
                print("ERROR: No response from daemon", file=sys.stderr)
                sys.exit(1)
            response = json.loads(buf.decode("utf-8"))

        if not response.get("ok"):
            print(f"ERROR: {response.get('error', 'Unknown error')}", file=sys.stderr)
            sys.exit(1)

        # Enter raw terminal mode
        fd = sys.stdin.fileno()
        old_settings = termios.tcgetattr(fd)
        try:
            tty.setraw(fd)
            _relay_loop(sock, fd)
        finally:
            termios.tcsetattr(fd, termios.TCSADRAIN, old_settings)

    finally:
        sock.close()


def _relay_loop(sock, stdin_fd):
    """Relay bytes between stdin/stdout and the daemon socket."""
    sock.setblocking(False)
    os.set_blocking(stdin_fd, False)

    resize_buf = b""

    while True:
        try:
            readable, _, _ = select.select([stdin_fd, sock], [], [], 0.1)
        except (ValueError, OSError):
            break

        for fd in readable:
            try:
                if fd == stdin_fd:
                    data = os.read(stdin_fd, 4096)
                    if not data:
                        # EOF on stdin
                        try:
                            sock.sendall(b"")
                        except (BrokenPipeError, OSError):
                            pass
                        return

                    # Check for Ctrl+C
                    if data == b"\x03":
                        try:
                            sock.sendall(data)
                        except (BrokenPipeError, OSError):
                            return
                        continue

                    # Check for Ctrl+D
                    if data == b"\x04":
                        try:
                            sock.sendall(b"")
                        except (BrokenPipeError, OSError):
                            pass
                        return

                    # Send resize escape on terminal size change
                    # (Could detect SIGWINCH here for production)
                    try:
                        sock.sendall(data)
                    except (BrokenPipeError, OSError):
                        return

                elif fd == sock:
                    data = sock.recv(4096)
                    if not data:
                        return
                    os.write(sys.stdout.fileno(), data)

            except (OSError, BrokenPipeError):
                return


def print_help():
    """Print usage information."""
    print(f"""immutable v{VERSION} -- Overlay management for immutable Pop!_OS

Usage:
  immutable create <name>       Create a new overlay (snapshot of @base)
  immutable shell <name>        Open interactive shell in overlay
  immutable run <name> <cmd>    Run command in overlay (non-interactive)
  immutable list                List all overlays
  immutable switch <name>       Set overlay as boot default (needs reboot)
  immutable reset <name>        Reset overlay to @base state
  immutable delete <name>       Delete an overlay
  immutable status              Show system status
  immutable lock                Lock @base (read-only)
  immutable unlock              Unlock @base (writable)
  immutable recovery            Switch to recovery overlay
  immutable reset-recovery      Reset recovery overlay from @base
  immutable update              Update CLI from @data
  immutable help                Show this help""")


def main():
    if len(sys.argv) < 2:
        print_help()
        sys.exit(0)

    cmd = sys.argv[1]

    if cmd in ("help", "--help", "-h"):
        print_help()
    elif cmd == "list":
        cmd_simple({"cmd": "list"})
    elif cmd == "status":
        cmd_simple({"cmd": "status"})
    elif cmd == "lock":
        cmd_simple({"cmd": "lock"})
    elif cmd == "unlock":
        cmd_simple({"cmd": "unlock"})
    elif cmd == "recovery":
        cmd_simple({"cmd": "switch", "name": "recovery"})
    elif cmd == "reset-recovery":
        cmd_simple({"cmd": "reset-recovery"})
    elif cmd == "create":
        if len(sys.argv) < 3:
            print("Usage: immutable create <name>", file=sys.stderr)
            sys.exit(1)
        cmd_simple({"cmd": "create", "name": sys.argv[2]})
    elif cmd == "delete":
        if len(sys.argv) < 3:
            print("Usage: immutable delete <name>", file=sys.stderr)
            sys.exit(1)
        cmd_simple({"cmd": "delete", "name": sys.argv[2]})
    elif cmd == "reset":
        if len(sys.argv) < 3:
            print("Usage: immutable reset <name>", file=sys.stderr)
            sys.exit(1)
        cmd_simple({"cmd": "reset", "name": sys.argv[2]})
    elif cmd == "switch":
        if len(sys.argv) < 3:
            print("Usage: immutable switch <name>", file=sys.stderr)
            sys.exit(1)
        cmd_simple({"cmd": "switch", "name": sys.argv[2]})
    elif cmd == "run":
        if len(sys.argv) < 4:
            print("Usage: immutable run <name> <command>", file=sys.stderr)
            sys.exit(1)
        cmd_run(sys.argv[2], sys.argv[3:])
    elif cmd == "shell":
        if len(sys.argv) < 3:
            print("Usage: immutable shell <name>", file=sys.stderr)
            sys.exit(1)
        cmd_shell(sys.argv[2], sys.argv[3:])
    elif cmd == "update":
        # Copy self to @data
        import shutil
        data_path = "/pool/@data/immutable"
        try:
            shutil.copy2(sys.argv[0], data_path)
            os.chmod(data_path, 0o755)
            print(f"Updated: {data_path}")
        except Exception as e:
            print(f"ERROR: {e}", file=sys.stderr)
            sys.exit(1)
    else:
        print(f"Unknown command: {cmd}", file=sys.stderr)
        print_help()
        sys.exit(1)


if __name__ == "__main__":
    main()
