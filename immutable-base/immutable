#!/usr/bin/env python3
"""Immutable Pop!_OS overlay management CLI.

Connects to the immutable-daemon over a Unix socket.
Runs as any user in the 'immutable' group.
"""
import sys
import os
import json
import socket
import struct
import signal
import select
import tty
import termios

VERSION = "0.4.0"
SOCKET_PATH = "/run/immutable/daemon.sock"


def connect() -> socket.socket:
    """Connect to the daemon socket."""
    if not os.path.exists(SOCKET_PATH):
        print("ERROR: Daemon not running. Start with: systemctl start immutable-daemon.socket",
              file=sys.stderr)
        sys.exit(1)

    sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    try:
        sock.connect(SOCKET_PATH)
    except ConnectionRefusedError:
        print("ERROR: Cannot connect to daemon. Is it running?", file=sys.stderr)
        print("  systemctl start immutable-daemon.socket", file=sys.stderr)
        sys.exit(1)
    return sock


def get_password():
    """Get password from IMMUTABLE_PASSWORD env var, or prompt interactively."""
    pw = os.environ.get("IMMUTABLE_PASSWORD")
    if pw:
        return pw
    import getpass
    return getpass.getpass("Password: ")


# Session vars set by the display manager / systemd-user, not by shell rc files.
# These must be forwarded from the user's session into the chroot.
SESSION_ENV_KEYS = [
    "WAYLAND_DISPLAY", "XDG_RUNTIME_DIR",
    "XDG_SESSION_TYPE", "XDG_SESSION_ID", "XDG_CURRENT_DESKTOP",
    "XDG_CONFIG_DIRS", "XDG_DATA_DIRS", "XDG_CACHE_HOME",
    "DISPLAY", "DBUS_SESSION_BUS_ADDRESS", "SESSION_MANAGER",
    "QT_QPA_PLATFORM", "QT_WAYLAND_DISABLE_WINDOWDECORATION",
    "GDK_BACKEND", "MOZ_ENABLE_WAYLAND", "SDL_VIDEODRIVER",
    "COLORTERM", "COSMIC_SESSION", "COSMIC_SESSION_UID",
]


def get_session_env() -> dict:
    """Collect session environment variables to forward into the chroot."""
    env = {}
    for key in SESSION_ENV_KEYS:
        val = os.environ.get(key)
        if val:
            env[key] = val
    return env


def send_command(cmd: dict) -> dict:
    """Send a command to the daemon and return the response."""
    sock = connect()
    try:
        msg = json.dumps(cmd, separators=(",", ":")) + "\n"
        sock.sendall(msg.encode("utf-8"))

        buf = b""
        while True:
            chunk = sock.recv(1)
            if not chunk or chunk == b"\n":
                break
            buf += chunk

        if buf:
            return json.loads(buf.decode("utf-8"))
        return {"ok": False, "error": "No response from daemon"}
    finally:
        sock.close()


def cmd_simple(args: dict):
    """Send a simple command and print the output."""
    result = send_command(args)
    if result.get("auth_required"):
        args["password"] = get_password()
        result = send_command(args)
    if result.get("ok"):
        print(result.get("output", ""))
    else:
        print(f"ERROR: {result.get('error', 'Unknown error')}", file=sys.stderr)
        sys.exit(1)


def cmd_run(overlay: str, run_args: list):
    """Run a non-interactive command with streaming output."""
    sock = connect()
    try:
        cmd = {
            "cmd": "run",
            "overlay": overlay,
            "args": run_args,
            "env": get_session_env(),
        }
        msg = json.dumps(cmd, separators=(",", ":")) + "\n"
        sock.sendall(msg.encode("utf-8"))

        exit_code = 1
        buf = b""
        auth_checked = False
        while True:
            chunk = sock.recv(4096)
            if not chunk:
                break

            buf += chunk
            while b"\n" in buf:
                line, buf = buf.split(b"\n", 1)
                if not line:
                    continue
                try:
                    event = json.loads(line.decode("utf-8"))
                except json.JSONDecodeError:
                    continue

                # Check for auth required on first response
                if not auth_checked and event.get("auth_required"):
                    sock.close()
                    cmd["password"] = get_password()
                    sock = connect()
                    msg = json.dumps(cmd, separators=(",", ":")) + "\n"
                    sock.sendall(msg.encode("utf-8"))
                    auth_checked = True
                    continue
                auth_checked = True

                if "error" in event and not event.get("ok", True):
                    print(f"ERROR: {event['error']}", file=sys.stderr)
                    sys.exit(1)
                elif event.get("stream") == "stdout":
                    sys.stdout.write(event.get("data", ""))
                    sys.stdout.flush()
                elif event.get("stream") == "stderr":
                    sys.stderr.write(event.get("data", ""))
                    sys.stderr.flush()
                elif event.get("type") == "done":
                    exit_code = event.get("exit_code", 1)

        sys.exit(exit_code)
    finally:
        sock.close()


def cmd_shell(overlay: str, shell_args: list):
    """Open an interactive shell session."""
    sock = connect()
    try:
        # Send PTY request
        cmd = {
            "cmd": "pty",
            "overlay": overlay,
            "args": shell_args,
            "env": get_session_env(),
        }
        msg = json.dumps(cmd, separators=(",", ":")) + "\n"
        sock.sendall(msg.encode("utf-8"))

        # Read initial response
        buf = b""
        while True:
            chunk = sock.recv(1)
            if not chunk or chunk == b"\n":
                break
            buf += chunk

        if not buf:
            print("ERROR: No response from daemon", file=sys.stderr)
            sys.exit(1)

        response = json.loads(buf.decode("utf-8"))

        # Handle auth required
        if response.get("auth_required"):
            sock.close()
            cmd["password"] = get_password()
            sock = connect()
            msg = json.dumps(cmd, separators=(",", ":")) + "\n"
            sock.sendall(msg.encode("utf-8"))
            buf = b""
            while True:
                chunk = sock.recv(1)
                if not chunk or chunk == b"\n":
                    break
                buf += chunk
            if not buf:
                print("ERROR: No response from daemon", file=sys.stderr)
                sys.exit(1)
            response = json.loads(buf.decode("utf-8"))

        if not response.get("ok"):
            print(f"ERROR: {response.get('error', 'Unknown error')}", file=sys.stderr)
            sys.exit(1)

        # Enter raw terminal mode
        fd = sys.stdin.fileno()
        old_settings = termios.tcgetattr(fd)
        try:
            tty.setraw(fd)
            _relay_loop(sock, fd)
        finally:
            termios.tcsetattr(fd, termios.TCSADRAIN, old_settings)

    finally:
        sock.close()


def _relay_loop(sock, stdin_fd):
    """Relay bytes between stdin/stdout and the daemon socket.

    On Ctrl+D we send the EOF marker to the daemon but keep reading
    until the daemon closes the socket (after teardown is complete).
    This keeps the overlay terminal visible during cleanup.
    """
    sock.setblocking(True)
    os.set_blocking(stdin_fd, False)

    sent_eof = False

    while True:
        try:
            readable, _, _ = select.select(
                [stdin_fd, sock] if not sent_eof else [sock],
                [], [], 0.1,
            )
        except (ValueError, OSError):
            break

        for fd in readable:
            if fd == stdin_fd:
                try:
                    data = os.read(stdin_fd, 4096)
                except BlockingIOError:
                    continue
                except OSError:
                    return
                if not data:
                    return

                if data == b"\x03":
                    try:
                        sock.sendall(data)
                    except (BrokenPipeError, ConnectionResetError):
                        return
                    continue

                if data == b"\x04":
                    try:
                        sock.sendall(b"")
                    except (BrokenPipeError, ConnectionResetError):
                        return
                    sent_eof = True
                    continue

                try:
                    sock.sendall(data)
                except (BrokenPipeError, ConnectionResetError):
                    return

            elif fd == sock:
                try:
                    data = sock.recv(256 * 1024)
                except (BrokenPipeError, ConnectionResetError):
                    return
                if not data:
                    return
                try:
                    os.write(sys.stdout.fileno(), data)
                except OSError:
                    pass


def _get_username() -> str:
    """Read the configured username."""
    try:
        with open("/etc/immutable.conf") as f:
            for line in f:
                if line.startswith("USERNAME="):
                    return line.split("=", 1)[1].strip()
    except (FileNotFoundError, ValueError):
        pass
    import pwd as _pwd
    for d in sorted(os.listdir("/home")):
        if os.path.isdir(f"/home/{d}") and d != "root":
            return d
    return "USERNAME"


# Items protected by @data bind-mounts — these survive overlay resets.
PROTECTED_DIRS = ["Documents", "Downloads", "Pictures", "Videos", "Music"]
PROTECTED_DOTFILES = [".bash_history", ".profile", ".bashrc", ".gitconfig"]


def cmd_reset(name: str):
    """Reset an overlay, with interactive home preservation for init."""
    pool = os.environ.get("IMMUTABLE_POOL", "/pool")
    overlay_prefix = "@overlay-"
    overlay_path = f"{pool}/{overlay_prefix}{name}"
    username = _get_username()
    home_dir = f"{overlay_path}/home/{username}"

    # Only offer preservation for overlays that have a real home directory
    has_unprotected = False
    unprotected_items = []

    if os.path.isdir(home_dir):
        try:
            entries = sorted(os.listdir(home_dir))
        except OSError:
            entries = []

        protected = set(PROTECTED_DIRS + PROTECTED_DOTFILES)
        for entry in entries:
            if entry not in protected:
                unprotected_items.append(entry)
                has_unprotected = True

    if has_unprotected:
        import shutil as _shutil
        term_width = _shutil.get_terminal_size((80, 24)).columns

        print(f"\nThe overlay '{name}' has files in /home/{username}/ that are NOT")
        print("preserved by @data bind-mounts and will be lost on reset:\n")

        # Build numbered entries with dir/ suffix
        entries = []
        for i, item in enumerate(unprotected_items, 1):
            full_path = os.path.join(home_dir, item)
            if os.path.isdir(full_path):
                entries.append(f"{i}. {item}/")
            else:
                entries.append(f"{i}. {item}")

        # Calculate column layout
        max_len = max(len(e) for e in entries)
        col_width = max_len + 2  # gap between columns
        num_cols = max(1, (term_width - 2) // col_width)  # 2 for indent
        rows = (len(entries) + num_cols - 1) // num_cols

        for row in range(rows):
            line = "  "
            for col in range(num_cols):
                idx = col * rows + row
                if idx < len(entries):
                    line += entries[idx].ljust(col_width)
            print(line)

        print(f"\n  P. Preserve all listed items")
        print(f"  S. Skip preservation (lose everything not in @data)")
        print()

        choice = input("Select items to preserve (comma-separated numbers, P, or S): ").strip()

        if choice.upper() == "S":
            preserve = []
        elif choice.upper() == "P":
            preserve = list(unprotected_items)
        elif not choice:
            preserve = []
        else:
            preserve = []
            for part in choice.split(","):
                part = part.strip()
                if part.isdigit():
                    idx = int(part) - 1
                    if 0 <= idx < len(unprotected_items):
                        preserve.append(unprotected_items[idx])

        if preserve:
            staging = f"{pool}/@data/.preserve-{name}"
            os.makedirs(staging, exist_ok=True)
            import shutil as _shutil
            for item in preserve:
                src = os.path.join(home_dir, item)
                dst = os.path.join(staging, item)
                if os.path.isdir(src):
                    _shutil.copytree(src, dst)
                else:
                    _shutil.copy2(src, dst)
            print(f"Preserved {len(preserve)} item(s) in {staging}")

        print(f"\nResetting overlay '{name}'...")
        cmd_simple({"cmd": "reset", "name": name})

        if preserve:
            new_home = f"{overlay_path}/home/{username}"
            os.makedirs(new_home, exist_ok=True)
            import shutil as _shutil
            for item in preserve:
                src = os.path.join(staging, item)
                dst = os.path.join(new_home, item)
                if os.path.isdir(src):
                    _shutil.copytree(src, dst)
                else:
                    _shutil.copy2(src, dst)
            _shutil.rmtree(staging)
            print(f"Restored {len(preserve)} preserved item(s)")
    else:
        cmd_simple({"cmd": "reset", "name": name})


def print_help():
    """Print usage information."""
    print(f"""immutable v{VERSION} -- Overlay management for immutable Pop!_OS

Usage:
  immutable create <name> [--from <source>]  Create overlay (default: active boot overlay)
  immutable shell <name>        Open interactive shell in overlay
  immutable run <name> <cmd>    Run command in overlay (non-interactive)
  immutable list                List all overlays
  immutable list-names          List overlay names (one per line, for scripting)
  immutable switch <name>       Set overlay as boot default (needs reboot)
  immutable reset <name>        Reset overlay from source (init: from recovery, others: from active boot)
  immutable delete <name>       Delete an overlay (not init or recovery)
  immutable status              Show system status
  immutable lock                Lock @base (read-only)
  immutable unlock              Unlock @base (writable)
  immutable recovery            Switch to recovery overlay (needs reboot)
  immutable reset-recovery      Recreate recovery from @base (read-only)
  immutable clean-boot          Remove stale boot entries from the ESP
  immutable update-initramfs [--version <ver>]
                                Update initramfs in boot overlay and copy to ESP
  immutable update              Update CLI from @data
  immutable help                Show this help""")


def main():
    if len(sys.argv) < 2:
        print_help()
        sys.exit(0)

    cmd = sys.argv[1]

    if cmd in ("help", "--help", "-h"):
        print_help()
    elif cmd == "list":
        cmd_simple({"cmd": "list"})
    elif cmd == "list-names":
        cmd_simple({"cmd": "list-names"})
    elif cmd == "status":
        cmd_simple({"cmd": "status"})
    elif cmd == "lock":
        cmd_simple({"cmd": "lock"})
    elif cmd == "unlock":
        cmd_simple({"cmd": "unlock"})
    elif cmd == "recovery":
        cmd_simple({"cmd": "switch", "name": "recovery"})
    elif cmd == "reset-recovery":
        cmd_simple({"cmd": "reset-recovery"})
    elif cmd == "clean-boot":
        cmd_simple({"cmd": "clean-boot"})
    elif cmd == "update-initramfs":
        msg = {"cmd": "update-initramfs"}
        if "--version" in sys.argv:
            idx = sys.argv.index("--version")
            if idx + 1 < len(sys.argv):
                msg["version"] = sys.argv[idx + 1]
            else:
                print("Usage: immutable update-initramfs [--version <ver>]", file=sys.stderr)
                sys.exit(1)
        cmd_simple(msg)
    elif cmd == "create":
        if len(sys.argv) < 3:
            print("Usage: immutable create <name> [--from <source>]", file=sys.stderr)
            sys.exit(1)
        name = sys.argv[2]
        source = None
        if "--from" in sys.argv:
            idx = sys.argv.index("--from")
            if idx + 1 < len(sys.argv):
                source = sys.argv[idx + 1]
            else:
                print("Usage: immutable create <name> [--from <source>]", file=sys.stderr)
                sys.exit(1)
        msg = {"cmd": "create", "name": name}
        if source:
            msg["source"] = source
        cmd_simple(msg)
    elif cmd == "delete":
        if len(sys.argv) < 3:
            print("Usage: immutable delete <name>", file=sys.stderr)
            sys.exit(1)
        cmd_simple({"cmd": "delete", "name": sys.argv[2]})
    elif cmd == "reset":
        if len(sys.argv) < 3:
            print("Usage: immutable reset <name>", file=sys.stderr)
            sys.exit(1)
        cmd_reset(sys.argv[2])
    elif cmd == "switch":
        if len(sys.argv) < 3:
            print("Usage: immutable switch <name>", file=sys.stderr)
            sys.exit(1)
        cmd_simple({"cmd": "switch", "name": sys.argv[2]})
    elif cmd == "run":
        if len(sys.argv) < 4:
            print("Usage: immutable run <name> <command>", file=sys.stderr)
            sys.exit(1)
        cmd_run(sys.argv[2], sys.argv[3:])
    elif cmd == "shell":
        if len(sys.argv) < 3:
            print("Usage: immutable shell <name>", file=sys.stderr)
            sys.exit(1)
        cmd_shell(sys.argv[2], sys.argv[3:])
    elif cmd == "update":
        # Copy self to @data
        import shutil
        data_path = "/pool/@data/immutable"
        try:
            shutil.copy2(sys.argv[0], data_path)
            os.chmod(data_path, 0o755)
            print(f"Updated: {data_path}")
        except Exception as e:
            print(f"ERROR: {e}", file=sys.stderr)
            sys.exit(1)
    else:
        print(f"Unknown command: {cmd}", file=sys.stderr)
        print_help()
        sys.exit(1)


if __name__ == "__main__":
    main()
