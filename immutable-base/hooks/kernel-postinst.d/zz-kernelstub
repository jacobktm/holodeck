#!/bin/bash
# Immutable-aware kernelstub wrapper for kernel post-install.
# Remounts ESP rw for kernelstub, then ro after.
# On the host, syncs the real ESP back to the overlay's ESP copy.

sync_back_to_overlay() {
    local subvol
    subvol=$(findmnt -no OPTIONS / 2>/dev/null | grep -oP 'subvol=\K[^,]+' 2>/dev/null)
    [ -n "$subvol" ] || return 0
    case "$subvol" in
        @overlay-*) ;;
        *) return 0 ;;
    esac
    local overlay_esp="/pool/$subvol/boot/efi"
    [ -d "$overlay_esp" ] || return 0
    rsync -a --delete /boot/efi/ "$overlay_esp/" 2>/dev/null || true
}

ROOT_DEV=$(stat -c '%d:%i' / 2>/dev/null)
REAL_ROOT_DEV=$(stat -c '%d:%i' "$(readlink -f /proc/1/root)" 2>/dev/null)

if [ "$ROOT_DEV" != "$REAL_ROOT_DEV" ]; then
    ESP="/boot/efi"
    if ! mountpoint -q "$ESP" 2>/dev/null; then
        exit 0
    fi
    if ! findmnt -no OPTIONS "$ESP" 2>/dev/null | grep -qw ro; then
        INITRD="/boot/initrd.img-$1"
        KERNEL="$2"
        kernelstub --verbose --preserve-live-mode || true
        exit 0
    fi
    if mount -o remount,rw,bind "$ESP" 2>/dev/null; then
        INITRD="/boot/initrd.img-$1"
        KERNEL="$2"
        kernelstub --verbose --preserve-live-mode || true
        mount -o remount,ro,bind "$ESP" 2>/dev/null
        exit 0
    fi
    exit 0
fi

ESP="/boot/efi"

RO_WAS=""
if findmnt -no OPTIONS "$ESP" 2>/dev/null | grep -qw ro; then
    RO_WAS=1
    mount -o remount,rw "$ESP" 2>/dev/null || exit 0
fi

INITRD="/boot/initrd.img-$1"
KERNEL="$2"

kernelstub --verbose --preserve-live-mode || true

sync_back_to_overlay

[ -n "$RO_WAS" ] && mount -o remount,ro "$ESP" 2>/dev/null || true
