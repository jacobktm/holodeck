#!/bin/bash
# Immutable-aware kernelstub wrapper for kernel post-install.
# Prompts for authorization if ESP hasn't been authorized yet.

ESP_AUTH_MARKER="/run/immutable/esp-authorized"
ESP_AUTH_TTL_MIN=10

check_esp_auth() {
    [ -f "$ESP_AUTH_MARKER" ] || return 1
    find "$ESP_AUTH_MARKER" -mmin -"$ESP_AUTH_TTL_MIN" -print -quit 2>/dev/null | grep -q .
}

ensure_esp_auth() {
    if check_esp_auth; then
        return 0
    fi
    echo "" >&2
    echo "kernelstub: ESP authorization required to update boot entries." >&2
    if command -v immutable >/dev/null 2>&1; then
        immutable auth 2>&1 || true
    fi
    check_esp_auth
}

ROOT_DEV=$(stat -c '%d:%i' / 2>/dev/null)
REAL_ROOT_DEV=$(stat -c '%d:%i' "$(readlink -f /proc/1/root)" 2>/dev/null)

if [ "$ROOT_DEV" != "$REAL_ROOT_DEV" ]; then
    ESP="/boot/efi"

    if ! mountpoint -q "$ESP" 2>/dev/null; then
        exit 0
    fi

    if ! findmnt -no OPTIONS "$ESP" 2>/dev/null | grep -qw ro; then
        if ! ensure_esp_auth; then
            echo "kernelstub: skipping ESP update (auth declined or failed)" >&2
            exit 0
        fi
        INITRD="/boot/initrd.img-$1"
        KERNEL="$2"
        exec kernelstub --verbose --preserve-live-mode
    fi

    if ! ensure_esp_auth; then
        echo "kernelstub: skipping ESP update (auth declined or failed)" >&2
        exit 0
    fi

    if sudo -n mount -o remount,rw,bind "$ESP" 2>/dev/null; then
        INITRD="/boot/initrd.img-$1"
        KERNEL="$2"
        kernelstub --verbose --preserve-live-mode || true
        mount -o remount,ro,bind "$ESP" 2>/dev/null
        exit 0
    fi

    exit 0
fi

if ! ensure_esp_auth; then
    echo "kernelstub: skipping ESP update (auth declined or failed)" >&2
    exit 0
fi

INITRD="/boot/initrd.img-$1"
KERNEL="$2"

exec kernelstub \
    --verbose \
    --preserve-live-mode
