#!/bin/bash
# Immutable-aware kernelstub replacement for kernel post-install.
# Runs kernelstub on the host; copies files directly in chroot.
# On the host, syncs the real ESP back to the overlay's ESP copy.

sync_back_to_overlay() {
    local subvol
    subvol=$(findmnt -no OPTIONS / 2>/dev/null | grep -oP 'subvol=\K[^,]+' 2>/dev/null)
    [ -n "$subvol" ] || return 0
    case "$subvol" in
        @overlay-*) ;;
        *) return 0 ;;
    esac
    local overlay_esp="/pool/$subvol/boot/efi"
    [ -d "$overlay_esp" ] || return 0
    rsync -a --delete /boot/efi/ "$overlay_esp/" 2>/dev/null || true
}

read_kernelstub_config() {
    local config_file="/etc/kernelstub/configuration"
    if [ -f "$config_file" ]; then
        python3 -c "
import json, sys
try:
    with open('$config_file') as f:
        cfg = json.load(f)
    opts = cfg.get('user', cfg.get('default', {})).get('kernel_options', [])
    print(' '.join(opts))
except Exception:
    sys.exit(1)
" 2>/dev/null && return 0
    fi
    echo "quiet splash"
}

find_esp_dir() {
    local esp_base="$1"
    for d in "$esp_base"/EFI/Pop_OS-*; do
        if [ -d "$d" ]; then
            echo "$d"
            return 0
        fi
    done
    if [ -d "$esp_base/EFI/systemd" ]; then
        echo "$esp_base/EFI/systemd"
        return 0
    fi
    return 1
}

# --- chroot detection ---
ROOT_DEV=$(stat -c '%d:%i' / 2>/dev/null)
REAL_ROOT_DEV=$(stat -c '%d:%i' "$(readlink -f /proc/1/root)" 2>/dev/null)

if [ "$ROOT_DEV" != "$REAL_ROOT_DEV" ]; then
    # Inside overlay shell (chroot) — replicate kernelstub's ESP operations
    ESP="/boot/efi"
    if ! mountpoint -q "$ESP" 2>/dev/null; then
        exit 0
    fi

    ESP_DIR=$(find_esp_dir "$ESP")
    [ -n "$ESP_DIR" ] || exit 0

    KERNEL_SRC="$2"
    INITRD_SRC="/boot/initrd.img-$1"
    [ -f "$KERNEL_SRC" ] || exit 0
    [ -f "$INITRD_SRC" ] || exit 0

    # Save previous kernel/initrd BEFORE overwriting (kernelstub's backup_old)
    if [ -f "${ESP_DIR}/vmlinuz.efi" ]; then
        rm -f "${ESP_DIR}/vmlinuz-previous.efi" 2>/dev/null || true
        cp "${ESP_DIR}/vmlinuz.efi" "${ESP_DIR}/vmlinuz-previous.efi" 2>/dev/null || true
    fi
    if [ -f "${ESP_DIR}/initrd.img" ]; then
        rm -f "${ESP_DIR}/initrd.img-previous" 2>/dev/null || true
        cp "${ESP_DIR}/initrd.img" "${ESP_DIR}/initrd.img-previous" 2>/dev/null || true
    fi

    # Copy new kernel (decompress if gzip'd, matching kernelstub behavior)
    if [ "$(xxd -l 2 -p "$KERNEL_SRC" 2>/dev/null)" = "1f8b" ]; then
        gunzip -c "$KERNEL_SRC" > "${ESP_DIR}/vmlinuz.efi" 2>/dev/null || \
        cp "$KERNEL_SRC" "${ESP_DIR}/vmlinuz.efi" 2>/dev/null || true
    else
        cp "$KERNEL_SRC" "${ESP_DIR}/vmlinuz.efi" 2>/dev/null || true
    fi

    cp "$INITRD_SRC" "${ESP_DIR}/initrd.img" 2>/dev/null || true

    # Copy /proc/cmdline to ESP (kernelstub does this for debug/info)
    cp /proc/cmdline "${ESP_DIR}/cmdline" 2>/dev/null || true

    exit 0
fi

# --- host path ---
ESP="/boot/efi"

RO_WAS=""
if findmnt -no OPTIONS "$ESP" 2>/dev/null | grep -qw ro; then
    RO_WAS=1
    mount -o remount,rw "$ESP" 2>/dev/null || exit 0
fi

INITRD="/boot/initrd.img-$1"
KERNEL="$2"

kernelstub --verbose --preserve-live-mode || true

sync_back_to_overlay

[ -n "$RO_WAS" ] && mount -o remount,ro "$ESP" 2>/dev/null || true
