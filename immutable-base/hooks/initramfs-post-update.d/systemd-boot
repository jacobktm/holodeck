#!/bin/sh
# Immutable-aware systemd-boot hook for initramfs post-update.
# Inside an overlay chroot: skip silently.
# On the host: run normally.

set -eu

# Detect chroot: /proc/1/root differs from our root
if [ "$(readlink -f /proc/1/root)" != "/" ]; then
    echo "immutable: skipping systemd-boot (running in overlay chroot)"
    exit 0
fi

test -x /usr/bin/bootctl || exit 0
bootctl is-installed --quiet || exit 0

echo "Updating kernel version $1 in systemd-boot..."
kernel-install add "$1" "/boot/vmlinuz-$1" "$2"
