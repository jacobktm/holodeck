#!/bin/bash
# Immutable-aware kernelstub wrapper for initramfs post-update.
# Inside an overlay chroot: skip silently (overlay kernels don't affect host boot).
# On the host: run kernelstub normally.

# Detect chroot: compare root filesystem device/inode to /proc/1/root's
ROOT_DEV=$(stat -c '%d:%i' / 2>/dev/null)
REAL_ROOT_DEV=$(stat -c '%d:%i' "$(readlink -f /proc/1/root)" 2>/dev/null)
if [ "$ROOT_DEV" != "$REAL_ROOT_DEV" ]; then
    echo "immutable: skipping kernelstub (running in chroot)"
    exit 0
fi

KERNEL="/boot/vmlinuz-$1"
INITRD="$2"

exec kernelstub \
    --verbose \
    --preserve-live-mode
