#!/bin/bash
# Immutable-aware kernelstub wrapper for initramfs post-update.
# Remounts ESP rw for kernelstub, then ro after.
# On the host, syncs the real ESP back to the overlay's ESP copy.

sync_back_to_overlay() {
    local subvol
    subvol=$(findmnt -no OPTIONS / 2>/dev/null | grep -oP 'subvol=\K[^,]+' 2>/dev/null)
    [ -n "$subvol" ] || return 0
    case "$subvol" in
        @overlay-*) ;;
        *) return 0 ;;
    esac
    local overlay_esp="/pool/$subvol/boot/efi"
    [ -d "$overlay_esp" ] || return 0
    rsync -a /boot/efi/ "$overlay_esp/" 2>/dev/null || true
}

ROOT_DEV=$(stat -c '%d:%i' / 2>/dev/null)
REAL_ROOT_DEV=$(stat -c '%d:%i' "$(readlink -f /proc/1/root)" 2>/dev/null)

if [ "$ROOT_DEV" != "$REAL_ROOT_DEV" ]; then
    # Inside overlay shell (chroot) — copy initrd to overlay's ESP copy directly
    ESP="/boot/efi"
    if ! mountpoint -q "$ESP" 2>/dev/null; then
        exit 0
    fi
    INITRD_SRC="$2"
    # Find ESP kernel directory (Pop_OS-<UUID> or systemd)
    ESP_DIR=""
    for d in "$ESP"/EFI/Pop_OS-*; do
        if [ -d "$d" ]; then
            ESP_DIR="$d"
            break
        fi
    done
    if [ -z "$ESP_DIR" ] && [ -d "$ESP/EFI/systemd" ]; then
        ESP_DIR="$ESP/EFI/systemd"
    fi
    if [ -n "$ESP_DIR" ] && [ -f "$INITRD_SRC" ]; then
        # Save previous initrd
        [ -f "$ESP_DIR/initrd.img" ] && cp "$ESP_DIR/initrd.img" "$ESP_DIR/initrd.img-previous" 2>/dev/null || true
        cp "$INITRD_SRC" "$ESP_DIR/initrd.img" 2>/dev/null || true
    fi
    exit 0
fi

ESP="/boot/efi"

RO_WAS=""
if findmnt -no OPTIONS "$ESP" 2>/dev/null | grep -qw ro; then
    RO_WAS=1
    mount -o remount,rw "$ESP" 2>/dev/null || exit 0
fi

KERNEL="/boot/vmlinuz-$1"
INITRD="$2"

kernelstub --verbose --preserve-live-mode || true

sync_back_to_overlay

[ -n "$RO_WAS" ] && mount -o remount,ro "$ESP" 2>/dev/null || true
