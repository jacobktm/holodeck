[Unit]
Description=Immutable overlay management daemon
After=local-fs.target
Requires=local-fs.target
RefuseManualStart=yes

[Service]
Type=simple
ExecStart=/usr/bin/python3 /pool/@data/immutable/daemon/daemon.py
WorkingDirectory=/pool/@data/immutable/daemon
User=root
Group=root

LimitNOFILE=65536
TimeoutStopSec=5
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
